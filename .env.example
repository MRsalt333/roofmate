# Demo / UI-only preview: if URL + public key (anon or publishable) are missing, the app
# runs in preview mode automatically. Once both are set, real saves are enabled even if
# NEXT_PUBLIC_DEMO_MODE=true is still present from the README quick start.
# NEXT_PUBLIC_DEMO_MODE=false  # optional: require keys and surface misconfiguration errors

# Supabase (required for auth + quotes)
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Or use a publishable key (newer dashboard) instead of anon:
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sync the database schema from this repo (after `npm run db:link` once):
#   npm run db:push
# Or run migration SQL manually in the Supabase SQL Editor under supabase/migrations/.

# Stripe (optional until payments ship)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Maps (optional — roof measurement scaffold)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
