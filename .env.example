# Demo / UI-only preview (no real Supabase). Optional: if you omit URL + anon key
# below, the app runs in preview mode automatically. Set to false to require real keys.
# NEXT_PUBLIC_DEMO_MODE=true

# Supabase (required for auth + quotes)
# Project Settings → API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# After connecting Supabase, run the SQL in supabase/migrations/20260214120000_quote_templates.sql
# (SQL editor → New query → paste → Run) so quote templates + RLS exist.

# Stripe (optional until payments ship)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Maps (optional — roof measurement scaffold)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
